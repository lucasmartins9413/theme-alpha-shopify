{%- comment -%}
  Usage: {% render 'article-card', article: article %}
{%- endcomment -%}

{%- assign card_article = article -%}

<a class="acard" href="{{ card_article.url }}">
  <div class="ah">
    {%- if card_article.image -%}
      {{ card_article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: card_article.title }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
    {%- if card_article.tags.size > 0 -%}
      <span class="acard-kicker">{{ card_article.tags.first }}</span>
    {%- endif -%}
  </div>

  <div class="acard-body">
    <div class="acard-date">{{ card_article.published_at | date: '%d/%m/%Y' }}</div>
    <h4>{{ card_article.title }}</h4>
    <p class="acard-excerpt">
      {%- if card_article.excerpt != blank -%}
        {{ card_article.excerpt | strip_html | truncatewords: 22 }}
      {%- else -%}
        {{ card_article.content | strip_html | truncatewords: 22 }}
      {%- endif -%}
    </p>
    <span class="acard-more">
      {{ 'blog.read_more' | t }}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </span>
  </div>
</a>
