{%- comment -%}
  Renders a <picture> with optional mobile source.
  Params:
    image          — desktop image (image_picker)
    mobile_image   — mobile image (image_picker, optional)
    width          — desktop render width in px (default 1200)
    mobile_width   — mobile render width in px (default 800)
    loading        — 'eager' | 'lazy' (default 'lazy')
    fetchpriority  — 'high' for above-fold images (optional)
    alt            — alt text
    placeholder    — Shopify placeholder name (default 'lifestyle-1')
{%- endcomment -%}

{%- assign _w   = width         | default: 1200 -%}
{%- assign _mw  = mobile_width  | default: 800  -%}
{%- assign _lod = loading       | default: 'lazy' -%}
{%- assign _alt = alt           | default: '' -%}
{%- assign _ph  = placeholder   | default: 'lifestyle-1' -%}

{%- if image != blank or mobile_image != blank -%}
  <picture>
    {%- if mobile_image != blank -%}
      <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: _mw }}">
    {%- endif -%}
    {%- assign _src = image | default: mobile_image -%}
    {%- if fetchpriority == 'high' -%}
      {{ _src | image_url: width: _w | image_tag: loading: _lod, fetchpriority: 'high', alt: _alt }}
    {%- else -%}
      {{ _src | image_url: width: _w | image_tag: loading: _lod, alt: _alt }}
    {%- endif -%}
  </picture>
{%- else -%}
  {{ _ph | placeholder_svg_tag }}
{%- endif -%}
