<nav class="crumb" aria-label="Breadcrumb">
  <a href="{{ routes.root_url }}">Home</a>

  {%- if template.name == 'collection' -%}
    <span class="sep">/</span>
    {%- if collection.metafields.custom.parent_collection != blank -%}
      <a href="{{ collection.metafields.custom.parent_collection.value.url }}">
        {{ collection.metafields.custom.parent_collection.value.title }}
      </a>
      <span class="sep">/</span>
    {%- endif -%}
    <b>{{ collection.title }}</b>

  {%- elsif template.name == 'product' -%}
    {%- if product.collections.first != blank -%}
      <span class="sep">/</span>
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
    {%- endif -%}
    <span class="sep">/</span>
    <b>{{ product.title | truncate: 40 }}</b>

  {%- elsif template.name == 'cart' -%}
    <span class="sep">/</span>
    <b>Minha Sacola</b>

  {%- elsif template.name == 'list-collections' -%}
    <span class="sep">/</span>
    <b>Coleções</b>

  {%- elsif template.name == 'page' -%}
    <span class="sep">/</span>
    <b>{{ page.title }}</b>

  {%- elsif template.name == 'blog' -%}
    <span class="sep">/</span>
    <b>{{ blog.title }}</b>

  {%- elsif template.name == 'article' -%}
    <span class="sep">/</span>
    <a href="{{ blog.url }}">{{ blog.title }}</a>
    <span class="sep">/</span>
    <b>{{ article.title | truncate: 40 }}</b>
  {%- endif -%}
</nav>

{%- capture _bc_items -%}
  {"@type":"ListItem","position":1,"name":"Home","item":{{ request.origin | append: routes.root_url | json }}}
  {%- if template.name == 'collection' -%}
    {%- if collection.metafields.custom.parent_collection != blank -%}
      ,{"@type":"ListItem","position":2,"name":{{ collection.metafields.custom.parent_collection.value.title | json }},"item":{{ request.origin | append: collection.metafields.custom.parent_collection.value.url | json }}}
      ,{"@type":"ListItem","position":3,"name":{{ collection.title | json }},"item":{{ request.origin | append: collection.url | json }}}
    {%- else -%}
      ,{"@type":"ListItem","position":2,"name":{{ collection.title | json }},"item":{{ request.origin | append: collection.url | json }}}
    {%- endif -%}
  {%- elsif template.name == 'product' -%}
    {%- if product.collections.first != blank -%}
      ,{"@type":"ListItem","position":2,"name":{{ product.collections.first.title | json }},"item":{{ request.origin | append: product.collections.first.url | json }}}
      ,{"@type":"ListItem","position":3,"name":{{ product.title | json }},"item":{{ request.origin | append: product.url | json }}}
    {%- else -%}
      ,{"@type":"ListItem","position":2,"name":{{ product.title | json }},"item":{{ request.origin | append: product.url | json }}}
    {%- endif -%}
  {%- elsif template.name == 'cart' -%}
    ,{"@type":"ListItem","position":2,"name":"Minha Sacola","item":{{ request.origin | append: routes.cart_url | json }}}
  {%- elsif template.name == 'list-collections' -%}
    ,{"@type":"ListItem","position":2,"name":"Coleções","item":{{ request.origin | append: routes.collections_url | json }}}
  {%- elsif template.name == 'page' -%}
    ,{"@type":"ListItem","position":2,"name":{{ page.title | json }},"item":{{ request.origin | append: page.url | json }}}
  {%- elsif template.name == 'blog' -%}
    ,{"@type":"ListItem","position":2,"name":{{ blog.title | json }},"item":{{ request.origin | append: blog.url | json }}}
  {%- elsif template.name == 'article' -%}
    ,{"@type":"ListItem","position":2,"name":{{ blog.title | json }},"item":{{ request.origin | append: blog.url | json }}}
    ,{"@type":"ListItem","position":3,"name":{{ article.title | json }},"item":{{ request.origin | append: article.url | json }}}
  {%- endif -%}
{%- endcapture -%}

<script type="application/ld+json">
  {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{{ _bc_items }}]}
</script>
