{%- comment -%}
  Usage: {% render 'product-card', product: product %}
{%- endcomment -%}

{%- assign card_product = product -%}
{%- assign show_badge = false -%}
{%- if card_product.compare_at_price > card_product.price -%}
  {%- assign show_badge = true -%}
  {%- assign discount_pct = card_product.compare_at_price | minus: card_product.price | times: 100 | divided_by: card_product.compare_at_price -%}
{%- endif -%}

<a class="pcard" href="{{ card_product.url }}">
  <div class="ph">
    {%- if show_badge -%}
      <span class="badge">
        <span class="fire">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c1 3-1 4-1 6a3 3 0 0 0 6 0c0 4-2 5-2 8a3 3 0 1 1-6 0c0-2 1-3 1-5-2 1-3 3-3 5a6 6 0 1 0 11-3c0-5-3-7-6-11z"/></svg>
        </span>
        {{ discount_pct }}% OFF
      </span>
    {%- endif -%}

    <button type="button" class="wish" aria-label="Favoritar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20s-7-4.3-9.2-8.4C1.2 8.7 2.6 5.5 5.8 5.5c1.9 0 3.2 1.1 4.2 2.4 1-1.3 2.3-2.4 4.2-2.4 3.2 0 4.6 3.2 3 6.1C19 15.7 12 20 12 20z"/></svg>
    </button>

    {%- if card_product.featured_image -%}
      {{ card_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: card_product.title }}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <h4>{{ card_product.title }}</h4>

  <div class="prow">
    <div class="pr">
      <b>{{ card_product.price | money }}</b>
      {%- if card_product.compare_at_price > card_product.price -%}
        <s>{{ card_product.compare_at_price | money }}</s>
      {%- endif -%}
    </div>
    <button type="button" class="addbtn"
      data-add-to-cart
      data-variant-id="{{ card_product.selected_or_first_available_variant.id }}"
      aria-label="Adicionar à sacola">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
    </button>
  </div>
</a>
