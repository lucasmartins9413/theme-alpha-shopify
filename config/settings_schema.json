      {
        "type": "color",
        "id": "color_promo",
        "label": "Cor de promoção (vermelho)",
        "default": "#e21c1c"
      }
    ]
  },
  {
    "name": "Tipografia",
    "settings": [
      {
        "type": "select",
        "id": "font_body",
        "label": "Fonte do corpo",
        "options": [
          { "value": "'Archivo', system-ui, sans-serif", "label": "Archivo (padrão)" },
          { "value": "system-ui, sans-serif", "label": "Sistema" }
        ],
        "default": "'Archivo', system-ui, sans-serif"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 50,
        "default": 1300,
        "unit": "px",
        "label": "Largura máxima da página"
      }
    ]
  },
  {
    "name": "Cashback",
    "settings": [
      {
        "type": "checkbox",
        "id": "cashback_enabled",
        "label": "Ativar programa de cashback",
