[
  {
    "name": "theme_info",
    "theme_name": "Alpha",
    "theme_author": "Alpha",
    "theme_version": "1.0.0",
    "theme_support_email": "lucasnunes9413@gmail.com",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes"
  },
  {
    "name": "Cores",
    "settings": [
      {
        "type": "color",
        "id": "color_accent",
        "label": "Cor de destaque",
        "default": "#5f9e2e"
      },
      {
        "type": "color",
        "id": "color_accent_bright",
        "label": "Cor de destaque (hover)",
        "default": "#6fb02f"
      },
      {
        "type": "color",
        "id": "color_promo",
        "label": "Cor de promoção",
        "default": "#e21c1c"
      }
    ]
  },
  {
    "name": "Tipografia",
    "settings": [
      {
        "type": "text",
        "id": "font_body",
        "label": "Fonte do corpo do texto",
        "info": "Deve ser uma das famílias já carregadas via Google Fonts no tema (Archivo, Saira Condensed, Saira).",
        "default": "'Archivo', system-ui, sans-serif"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Largura máxima do conteúdo",
        "min": 1100,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1300
      }
    ]
  },
  {
    "name": "Cashback & Frete",
    "settings": [
      {
        "type": "checkbox",
        "id": "cashback_enabled",
        "label": "Ativar cashback",
        "default": true
      },
      {
        "type": "range",
        "id": "cashback_percent",
        "label": "Percentual de cashback",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "%",
        "default": 10
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Valor mínimo para frete grátis (R$)",
        "default": 199
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Imagem do favicon",
        "info": "Recomendado: imagem quadrada, 32x32px ou maior."
      }
    ]
  }
]
