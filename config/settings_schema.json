        "type": "range",
        "id": "cashback_percent",
        "min": 1,
        "max": 20,
        "step": 1,
        "default": 10,
        "unit": "%",
        "label": "Percentual de cashback"
      }
    ]
  },
  {
    "name": "Frete Grátis",
    "settings": [
