<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {{ content_for_header }}

  {%- if settings.favicon -%}
    <link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}">
  {%- endif -%}

  {%- assign _archivo_weights = '400,500,600,700,800,900' | split: ',' -%}
  {%- assign _saira_weights = '400,500,600,700,800' | split: ',' -%}
  {%- assign _saira_condensed_weights = '500,600,700,800,900' | split: ',' -%}
  <style>
    {%- for weight in _archivo_weights -%}
    @font-face {
      font-family: 'Archivo';
      font-style: normal;
      font-weight: {{ weight }};
      font-display: swap;
      src: url({{ 'archivo-variable.woff2' | asset_url }}) format('woff2');
    }
    {%- endfor -%}
    {%- for weight in _saira_weights -%}
    @font-face {
      font-family: 'Saira';
      font-style: normal;
      font-weight: {{ weight }};
      font-display: swap;
      src: url({{ 'saira-variable.woff2' | asset_url }}) format('woff2');
    }
    {%- endfor -%}
    {%- for weight in _saira_condensed_weights -%}
    @font-face {
      font-family: 'Saira Condensed';
      font-style: normal;
      font-weight: {{ weight }};
      font-display: swap;
      src: url({{ 'saira-condensed-' | append: weight | append: '.woff2' | asset_url }}) format('woff2');
    }
    {%- endfor -%}
  </style>

  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>

  <style>
    :root {
      --green: {{ settings.color_accent | default: '#5f9e2e' }};
      --green-bright: {{ settings.color_accent_bright | default: '#6fb02f' }};
      --red: {{ settings.color_promo | default: '#e21c1c' }};
      --font-body: {{ settings.font_body | default: "'Archivo', system-ui, sans-serif" }};
      --maxw: {{ settings.page_width | default: 1300 }}px;
    }
  </style>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: routes.root_url | json }}
      {%- if shop.email != blank -%},
      "email": {{ shop.email | json }}
      {%- endif -%}
    }
  </script>
  {%- assign _search_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: routes.root_url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ _search_target | json }},
        "query-input": "required name=search_term_string"
      }
    }
  </script>
</head>

<body class="template-{{ template.name }}">
  <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
  {%- section 'announcement-bar' -%}
  {%- section 'header' -%}

  <main id="MainContent" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- section 'newsletter' -%}
  {%- section 'footer' -%}
  {%- section 'cart-drawer' -%}

  <div class="popup-overlay" id="popupOverlay"></div>
  {%- section 'newsletter-popup' -%}
  {%- section 'promo-popup' -%}
  {%- section 'exit-popup' -%}
</body>
</html>
