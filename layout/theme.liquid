<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Saira+Condensed:wght@500;600;700;800;900&family=Saira:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
</head>

<body class="template-{{ template.name }}">
  {%- section 'announcement-bar' -%}
  {%- section 'header' -%}

  <main id="MainContent" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- section 'footer' -%}
  {%- section 'cart-drawer' -%}
</body>
</html>
