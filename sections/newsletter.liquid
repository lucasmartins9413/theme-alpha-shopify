{%- if section.settings.enabled -%}
  <section class="sec newsletter-sec">
    <div class="wrap newsletter-wrap">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="newsletter-sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'NewsletterForm', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">

        {%- if form.posted_successfully? -%}
          <p class="newsletter-msg success">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="newsletter-msg error">{{ 'newsletter.error' | t }}</p>
          {%- endif -%}
          <div class="newsletter-field">
            <input
              type="email"
              name="contact[email]"
              id="NewsletterEmail"
              placeholder="{{ 'newsletter.email_placeholder' | t }}"
              autocomplete="email"
              required>
            <button type="submit" class="btn-solid">{{ 'newsletter.submit' | t }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Ativar seção",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Fique por dentro"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Cadastre seu e-mail e receba novidades, lançamentos e ofertas exclusivas."
    }
  ]
}
{% endschema %}
