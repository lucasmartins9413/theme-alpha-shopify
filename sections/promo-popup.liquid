{%- if section.settings.enabled -%}
  <div class="popup popup--promo" id="PromoPopup" data-popup-type="onload" data-delay="{{ section.settings.delay_seconds | default: 3 }}" role="dialog" aria-modal="true" aria-hidden="true">
    <button type="button" class="popup-close" data-popup-close aria-label="{{ 'general.close' | t }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>

    {%- if section.settings.image -%}
      <div class="popup-img">
        {{ section.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: section.settings.heading }}
      </div>
    {%- endif -%}

    <div class="popup-body">
      <h3>{{ section.settings.heading }}</h3>
      <p>{{ section.settings.subheading }}</p>

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_url | default: '#' }}" class="btn-solid">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Popup — Promoção",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Ativar popup",
      "default": false
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Aparece após (segundos)",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 3
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem (opcional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Copa 2026 chegou"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Coleção especial com 10% de cashback em todas as compras."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão",
      "default": "Ver coleção"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Link do botão"
    }
  ]
}
{% endschema %}
