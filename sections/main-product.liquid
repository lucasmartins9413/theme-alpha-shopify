<div class="wrap">
  {%- render 'breadcrumb' -%}

  <div class="pdp">
    <!-- Thumbnails -->
    <div class="thumbs">
      {%- for media in product.media -%}
        <div class="thumb {% if forloop.first %}on{% endif %}" data-index="{{ forloop.index0 }}">
          {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: product.title }}
        </div>
      {%- endfor -%}
    </div>

    <!-- Main image -->
    <div class="stage">
      {%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
      {%- if product.compare_at_price > product.price -%}
        {%- assign discount_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
        <span class="badge">
          <span class="fire" style="color:var(--green);display:grid;place-items:center;">
            <svg viewBox="0 0 24 24" fill="currentColor" style="width:11px;height:11px;"><path d="M12 2c1 3-1 4-1 6a3 3 0 0 0 6 0c0 4-2 5-2 8a3 3 0 1 1-6 0c0-2 1-3 1-5-2 1-3 3-3 5a6 6 0 1 0 11-3c0-5-3-7-6-11z"/></svg>
          </span>
          {{ discount_pct }}% OFF
        </span>
      {%- endif -%}

      {%- if featured_media -%}
        {{ featured_media | image_url: width: 900 | image_tag: loading: 'eager', id: 'ProductMainImage', alt: product.title }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag }}
      {%- endif -%}

      <button class="gnav l" id="prevImg">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 6-6 6 6 6"/></svg>
      </button>
      <button class="gnav r" id="nextImg">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6"/></svg>
      </button>
    </div>

    <!-- Info panel -->
    <div class="info">
      <div class="brandrow">
        {{ product.vendor }}
        {%- if product.metafields.custom.collection_label != blank -%}
          · {{ product.metafields.custom.collection_label }}
        {%- endif -%}
      </div>

      <h1>{{ product.title }}</h1>

      {%- if product.metafields.reviews.rating != blank -%}
        <div class="rate">
          <div class="stars">
            {%- assign rating = product.metafields.reviews.rating.value.rating -%}
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 24 24" fill="{% if i <= rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.5">
                <path d="M12 2l3 6 6 .9-4.4 4.3 1 6.1L12 17.8 6.4 19.3l1-6.1L3 8.9 9 8z"/>
              </svg>
            {%- endfor -%}
          </div>
          <span>
            <b style="color:#111">{{ product.metafields.reviews.rating.value.rating }}</b>
            · {{ product.metafields.reviews.rating_count }} avaliações
          </span>
        </div>
      {%- endif -%}

      <div class="price-block">
        <span class="now">{{ product.selected_or_first_available_variant.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="old">{{ product.compare_at_price | money }}</span>
          <span class="tag">-{{ discount_pct }}%</span>
        {%- endif -%}
      </div>

      <div class="installments">em até <b>10x de {{ product.selected_or_first_available_variant.price | divided_by: 10 | money }}</b> sem juros</div>

      <div class="pix-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="width:16px;height:16px;"><path d="M12 3 3 12l9 9 9-9z"/></svg>
        <b>{{ product.selected_or_first_available_variant.price | times: 0.9 | money }}</b> no Pix (10% off)
      </div>

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div class="vlabel">
            {{ option.name }}
            {%- if option.name == 'Cor' -%}
              <span id="colorName">{{ option.values.first }}</span>
            {%- endif -%}
          </div>

          {%- if option.name == 'Cor' -%}
            <div class="colorrow">
              {%- for value in option.values -%}
                <span class="csw {% if forloop.first %}on{% endif %}"
                  data-name="{{ value }}"
                  data-option-index="{{ forloop.parentloop.index0 }}"
                  title="{{ value }}"
                  style="background:{{ value | handleize | prepend: 'var(--color-' | append: ')' }}">
                </span>
              {%- endfor -%}
            </div>
          {%- elsif option.name == 'Tamanho' -%}
            <div class="sizerow">
              {%- for value in option.values -%}
                {%- assign variant_available = false -%}
                {%- for variant in product.variants -%}
                  {%- if variant.option1 == value or variant.option2 == value -%}
                    {%- if variant.available -%}
                      {%- assign variant_available = true -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                <span class="sz {% if forloop.first %}on{% endif %} {% unless variant_available %}off{% endunless %}"
                  data-value="{{ value }}">
                  {{ value }}
                </span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endunless -%}

      <a class="guide" href="#">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h18v10H3z"/><path d="M7 7v4M11 7v6M15 7v4M19 7v6"/></svg>
        Não sei meu tamanho
      </a>

      {%- form 'product', product, id: 'ProductForm' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="VariantId">
        <div class="buyrow">
          <div class="qty">
            <button type="button" onclick="qd(-1)">−</button>
            <span id="qv">1</span>
            <button type="button" onclick="qd(1)">+</button>
          </div>
          <button type="submit" class="btn-solid" name="add">
            Adicionar à sacola
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </div>
      {%- endform -%}

      <div class="perks">
        <div class="perk">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M1 3h13v10H1zM14 6h4l3 3v4h-7"/><circle cx="5.5" cy="16.5" r="2"/><circle cx="17.5" cy="16.5" r="2"/></svg></span>
          Frete grátis acima de R$ 199
        </div>
        <div class="perk">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 12a9 9 0 1 0 3-6.7M3 4v4h4"/></svg></span>
          Troca fácil em 30 dias
        </div>
        <div class="perk">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg></span>
          10x sem juros
        </div>
        <div class="perk">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5z"/></svg></span>
          Compra 100% segura
        </div>
      </div>

      <div class="cep">
        <h5>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-5.2-7-11a7 7 0 0 1 14 0c0 5.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
          Calcular frete e prazo
        </h5>
        <div class="fields">
          <input type="text" placeholder="Digite seu CEP" id="cepInput" />
          <button class="go" type="button">OK</button>
        </div>
      </div>

      <div class="acc">
        <div class="item open">
          <div class="head">Descrição <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></div>
          <div class="body">{{ product.description }}</div>
        </div>
        {%- if product.metafields.custom.composition != blank -%}
          <div class="item">
            <div class="head">Composição & Cuidados <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></div>
            <div class="body">{{ product.metafields.custom.composition }}</div>
          </div>
        {%- endif -%}
        <div class="item">
          <div class="head">Entrega & Devolução <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></div>
          <div class="body">Envio em até 48h. Frete grátis para compras acima de R$ 199. Você tem 30 dias para trocar ou devolver pelo programa Troque Fácil.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Related products -->
  {%- if section.settings.show_related -%}
    {%- assign related_collection = collections[product.collections.first.handle] -%}
    {%- if related_collection != blank -%}
      <section class="sec" style="padding-top:30px;">
        <div class="sec-head">
          <div class="titles">
            <h2>Quem viu, comprou também</h2>
            <p>Complete o seu look de performance.</p>
          </div>
          <div class="sec-arrows">
            <button class="iconbtn" data-scroll="relScroll" data-dir="-1">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 6-6 6 6 6"/></svg>
            </button>
            <button class="iconbtn" data-scroll="relScroll" data-dir="1">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6"/></svg>
            </button>
          </div>
        </div>
        <div class="scroller" id="relScroll">
          {%- for rel in related_collection.products limit: 8 -%}
            {%- unless rel.handle == product.handle -%}
              {%- render 'product-card', product: rel -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  {%- endif -%}
</div>

<script>
(function(){
  const mediaUrls = [
    {%- for media in product.media -%}
      "{{ media | image_url: width: 900 }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];
  let imgIdx = 0;
  const mainImg = document.getElementById('ProductMainImage');
  function showImg(i){
    imgIdx = (i + mediaUrls.length) % mediaUrls.length;
    if(mainImg) mainImg.src = mediaUrls[imgIdx];
    document.querySelectorAll('.thumb').forEach((t,j) => t.classList.toggle('on', j === imgIdx));
  }
  document.getElementById('prevImg')?.addEventListener('click', () => showImg(imgIdx - 1));
  document.getElementById('nextImg')?.addEventListener('click', () => showImg(imgIdx + 1));
  document.querySelectorAll('.thumb').forEach((t, i) => t.addEventListener('click', () => showImg(i)));
})();
</script>

{% schema %}
{
  "name": "Produto Principal",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Mostrar produtos relacionados",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Produto Principal"
    }
  ]
}
{% endschema %}
