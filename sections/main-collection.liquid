<div class="pagehero">
  <div class="wrap">
    {%- render 'breadcrumb' -%}
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p class="sub">{{ collection.description }}</p>
    {%- endif -%}
    <div class="count">{{ collection.products_count }} produtos</div>

    <div class="quickrow">
      <button class="qchip on">Todos</button>
      {%- for tag in collection.all_tags limit: 7 -%}
        <button class="qchip">{{ tag }}</button>
      {%- endfor -%}
    </div>
  </div>
</div>

<div class="wrap">
  <div class="collection-layout">
    <aside class="filters">
      <div class="fblock">
        <h4>Categoria <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m6 9 6 6 6-6"/></svg></h4>
        <div class="fbody">
          {%- for tag in collection.all_tags -%}
            <label class="opt">
              <input type="checkbox" name="tag" value="{{ tag }}" {% if current_tags contains tag %}checked{% endif %}>
              {{ tag }}
            </label>
          {%- endfor -%}
        </div>
      </div>

      <div class="fblock">
        <h4>Tamanho <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m6 9 6 6 6-6"/></svg></h4>
        <div class="fbody">
          <div class="sizes">
            {%- assign size_values = 'PP,P,M,G,GG,XGG' | split: ',' -%}
            {%- for sz in size_values -%}
              <span class="sizebox">{{ sz }}</span>
            {%- endfor -%}
          </div>
        </div>
      </div>

      <div class="fblock">
        <h4>Preço <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m6 9 6 6 6-6"/></svg></h4>
        <div class="fbody">
          <div class="pricefields">
            <input type="text" value="R$ 0" />
            <span>—</span>
            <input type="text" value="R$ 250" />
          </div>
        </div>
      </div>
    </aside>

    <main>
      {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
      {%- assign sort_options = 'manual|Relevância,best-selling|Mais vendidos,price-ascending|Menor preço,price-descending|Maior preço,created-descending|Mais novos,title-ascending|A – Z' | split: ',' -%}
      {%- assign sort_label = 'Relevância' -%}
      {%- for opt in sort_options -%}
        {%- assign opt_parts = opt | split: '|' -%}
        {%- if opt_parts[0] == sort_by -%}
          {%- assign sort_label = opt_parts[1] -%}
        {%- endif -%}
      {%- endfor -%}

      <div class="toolbar">
        <div class="activechips">
          {%- for tag in current_tags -%}
            <span class="achip">
              {{ tag }}
              <button aria-label="Remover filtro {{ tag }}">✕</button>
            </span>
          {%- endfor -%}
        </div>

        <div class="toolbar-right">
          <div class="view-toggle" id="viewToggle">
            <button class="view-btn" data-view="grid" aria-label="Visualização em grade">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            </button>
            <button class="view-btn" data-view="list" aria-label="Visualização em lista">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"/></svg>
            </button>
          </div>

          <div class="sortwrap">
            <button class="sortbtn" id="colSortBtn">
              {{ sort_label }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="sort-dropdown" id="colSortDropdown" hidden>
              {%- for opt in sort_options -%}
                {%- assign opt_parts = opt | split: '|' -%}
                <a href="{{ collection.url }}?sort_by={{ opt_parts[0] }}"
                   class="sort-opt{% if opt_parts[0] == sort_by %} is-active{% endif %}">
                  {{ opt_parts[1] }}
                </a>
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>

      <div class="product-grid" id="productGrid">
        {%- paginate collection.products by section.settings.products_per_page -%}
          {%- for product in collection.products -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        {%- endpaginate -%}
      </div>

      {%- if collection.products_count > section.settings.products_per_page -%}
        <div class="loadmore">
          <p>Você viu <b>{{ section.settings.products_per_page }}</b> de {{ collection.products_count }} produtos</p>
          <div class="barwrap">
            <i style="width:{{ section.settings.products_per_page | times: 100 | divided_by: collection.products_count }}%"></i>
          </div>
          {%- if paginate.next -%}
            <a class="btn-ghost" href="{{ paginate.next.url }}">Carregar mais</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </main>
  </div>
</div>

<script>
(function () {
  /* ---- Sort dropdown ---- */
  var sortBtn = document.getElementById('colSortBtn');
  var sortDrop = document.getElementById('colSortDropdown');
  if (sortBtn && sortDrop) {
    sortBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = !sortDrop.hidden;
      sortDrop.hidden = open;
      sortBtn.classList.toggle('is-open', !open);
    });
    document.addEventListener('click', function () {
      sortDrop.hidden = true;
      sortBtn.classList.remove('is-open');
    });
  }

  /* ---- View toggle (grid / list) ---- */
  var grid    = document.getElementById('productGrid');
  var toggle  = document.getElementById('viewToggle');
  var STORAGE = 'alpha-col-view';

  function applyView(view) {
    if (!grid) return;
    grid.classList.toggle('product-grid--list', view === 'list');
    toggle?.querySelectorAll('.view-btn').forEach(function (b) {
      b.classList.toggle('is-active', b.dataset.view === view);
    });
    try { localStorage.setItem(STORAGE, view); } catch (_) {}
  }

  var saved = 'grid';
  try { saved = localStorage.getItem(STORAGE) || 'grid'; } catch (_) {}
  applyView(saved);

  toggle?.querySelectorAll('.view-btn').forEach(function (btn) {
    btn.addEventListener('click', function () { applyView(btn.dataset.view); });
  });
})();
</script>

{% schema %}
{
  "name": "Coleção Principal",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 48,
      "step": 6,
      "default": 12,
      "label": "Produtos por página"
    }
  ],
  "presets": [
    {
      "name": "Coleção Principal"
    }
  ]
}
{% endschema %}
