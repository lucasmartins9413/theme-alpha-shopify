<section class="hero">
  {%- for block in section.blocks -%}
    <div class="hero-slide{% if forloop.first %} active{% endif %}" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        {%- if forloop.first -%}
          {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', alt: block.settings.image.alt }}
        {%- else -%}
          {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: block.settings.image.alt }}
        {%- endif -%}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}

      <div class="hero-graf">
        {%- if block.settings.eyebrow != blank -%}
          <div class="small">{{ block.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <div class="big">{{ block.settings.heading }}</div>
        {%- endif -%}
        {%- if block.settings.subheading != blank -%}
          <div class="tag">{{ block.settings.subheading }}</div>
        {%- endif -%}
      </div>

      <a class="hero-cta" href="{{ block.settings.cta_url | default: '#' }}">
        <span>{{ block.settings.cta_label | default: 'Comprar Agora' }}</span>
        <span class="circ">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </a>
    </div>
  {%- endfor -%}

  {%- if section.blocks.size > 1 -%}
    <button class="hero-nav prev" aria-label="Anterior">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 6-6 6 6 6"/></svg>
    </button>
    <button class="hero-nav next" aria-label="Próximo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6"/></svg>
    </button>
    <div class="hero-dots">
      {%- for block in section.blocks -%}
        <i{% if forloop.first %} class="on"{% endif %}></i>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<script>
(function () {
  var hero = document.querySelector('.hero');
  if (!hero) return;
  var slides = hero.querySelectorAll('.hero-slide');
  var dots   = hero.querySelectorAll('.hero-dots i');
  if (slides.length <= 1) return;

  var current = 0;
  var timer;

  function goTo(n) {
    slides[current].classList.remove('active');
    if (dots[current]) dots[current].classList.remove('on');
    current = (n + slides.length) % slides.length;
    slides[current].classList.add('active');
    if (dots[current]) dots[current].classList.add('on');
  }

  function startTimer() {
    clearInterval(timer);
    timer = setInterval(function () { goTo(current + 1); }, 6000);
  }

  hero.querySelector('.hero-nav.prev').addEventListener('click', function () { goTo(current - 1); startTimer(); });
  hero.querySelector('.hero-nav.next').addEventListener('click', function () { goTo(current + 1); startTimer(); });

  startTimer();
})();
</script>

{% schema %}
{
  "name": "Banner Hero",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem do banner"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Texto pequeno (acima)",
          "default": "SELECAO"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Titulo grande",
          "default": "OVER"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subtitulo",
          "default": "Edicao Limitada"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Texto do botao",
          "default": "Comprar Agora"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Link do botao"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner Hero",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "SELECAO",
            "heading": "OVER",
            "subheading": "Edicao Limitada",
            "cta_label": "Comprar Agora"
          }
        }
      ]
    }
  ],
  "max_blocks": 5
}
{% endschema %}
